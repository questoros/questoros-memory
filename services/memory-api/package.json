{
  "name": "@questoros-memory/memory-api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify REST API for QuestorOS Memory",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@questoros-memory/memory-core": "workspace:*",
    "@questoros-memory/memory-service": "workspace:*",
    "@questoros-memory/database": "workspace:*",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "tsx": "^4.19.0"
  }
}
