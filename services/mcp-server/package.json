{
  "name": "@questoros-memory/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio and authenticated read-only Streamable HTTP MCP transports for QuestorOS Memory",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "dev:remote": "tsx src/remote-cli.ts",
    "start:remote": "node dist/remote-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@questoros-memory/memory-core": "workspace:*",
    "@questoros-memory/memory-service": "workspace:*",
    "@questoros-memory/database": "workspace:*",
    "dotenv": "^16.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "tsx": "^4.19.0"
  }
}
