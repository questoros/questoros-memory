{
  "name": "@questoros-memory/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schema, migrations, CockroachDB client, and vector-index definitions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:bootstrap": "tsx scripts/bootstrap-database.ts",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:verify-vector": "tsx scripts/verify-vector-contract.ts",
    "auth:bootstrap-local": "tsx scripts/bootstrap-local-auth.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@questoros-memory/memory-core": "workspace:*",
    "dotenv": "^16.5.0",
    "pg": "^8.14.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
