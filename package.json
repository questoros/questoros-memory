{
  "name": "questoros-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Portable, explainable, user-controlled memory layer for AI agents",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "dev:api": "pnpm --filter @questoros-memory/memory-api dev",
    "dev:mcp": "pnpm --filter @questoros-memory/mcp-server dev",
    "start:api": "pnpm --filter @questoros-memory/memory-api start",
    "start:mcp": "pnpm --filter @questoros-memory/mcp-server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check .",
    "acceptance:phase5": "tsx --env-file=.env scripts/phase5-acceptance.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@questoros-memory/continuity-agent": "workspace:*",
    "@questoros-memory/database": "workspace:*",
    "@questoros-memory/drive-google": "workspace:*",
    "@questoros-memory/drive-microsoft": "workspace:*",
    "@questoros-memory/harvester-core": "workspace:*",
    "@questoros-memory/memory-api": "workspace:*",
    "@questoros-memory/memory-core": "workspace:*",
    "@questoros-memory/memory-service": "workspace:*",
    "@questoros-memory/publisher-core": "workspace:*",
    "@questoros-memory/reasoning-provider": "workspace:*",
    "@questoros-memory/sdk": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
