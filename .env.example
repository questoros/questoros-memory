# CockroachDB target database. Never commit the real value.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:26257/questoros_memory?sslmode=verify-full"
DATABASE_NAME="questoros_memory"

# Private API keys. Keep real values only in ignored local files or secret stores.
QUESTOROS_MEMORY_API_KEY="qmem_local_placeholder"
QUESTOROS_MEMORY_STAGING_API_KEY="qmem_live_placeholder"

# Approved Phase 8 staging endpoints.
QUESTOROS_MEMORY_STAGING_URL="https://blrt2ds22f.execute-api.ap-southeast-1.amazonaws.com/staging"
QUESTOROS_MEMORY_REMOTE_MCP_URL="https://blrt2ds22f.execute-api.ap-southeast-1.amazonaws.com/staging/mcp"

# Embedding provider contract. Defaults never invoke AWS from CI or unit tests.
EMBEDDING_PROVIDER="amazon-bedrock"
EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
EMBEDDING_DIMENSIONS="1024"
EMBEDDING_NORMALIZE="true"
AWS_BEDROCK_REGION="us-west-2"
EMBEDDING_AUTO_ON_WRITE="false"
EMBEDDING_MAX_INPUT_CHARACTERS="20000"
EMBEDDING_TIMEOUT_MS="10000"
EMBEDDING_MAX_ATTEMPTS="3"

# Structured reasoning defaults to mock and never invokes AWS unless explicitly enabled.
REASONING_PROVIDER="mock"
REASONING_MODEL_ID="mock-structured-v1"
REASONING_REGION="us-west-2"
REASONING_ALLOW_LIVE_CALLS="false"
REASONING_MAX_INPUT_CHARACTERS="24000"
REASONING_MAX_OUTPUT_TOKENS="2048"
REASONING_TIMEOUT_MS="15000"

# Remote MCP development defaults. The deployed staging origin allowlist is empty.
REMOTE_MCP_ENABLED="false"
REMOTE_MCP_HOST="127.0.0.1"
REMOTE_MCP_PORT="3100"
REMOTE_MCP_ALLOWED_ORIGINS=""
REMOTE_MCP_ALLOW_PUBLIC_BIND="false"

# Opt-in integration and acceptance gates.
RUN_DATABASE_INTEGRATION_TESTS="false"
RUN_PHASE8_REMOTE_MCP_SMOKE="false"
RUN_PHASE8_REMOTE_MCP_DIAGNOSTIC="false"
RUN_PHASE8_DEMO="false"

# Do not set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# AWS_BEARER_TOKEN_BEDROCK, or AWS_PROFILE in tracked files.
# Local developers may use ignored AWS CLI/SSO configuration.
# Deployed code must use an IAM role.
