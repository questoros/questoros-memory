# CockroachDB application connection.
# Never commit the real value.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full"

# Application environment.
NODE_ENV="development"

# AWS region for the hackathon deployment.
AWS_REGION="ap-southeast-1"

# Future memory service settings.
QUESTOROS_MEMORY_SERVICE_NAME="questoros-memory"
QUESTOROS_MEMORY_MCP_TRANSPORT="http"
